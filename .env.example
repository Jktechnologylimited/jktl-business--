# Configure secrets securely in the deployment environment. Never commit values.
DATABASE_URL=
NEXT_PUBLIC_APP_URL=https://business.jktl.com.ng
PAYSTACK_SECRET_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
CRON_SECRET=
# Required for paid domain checkout: 32 random bytes encoded as base64. Back up securely.
DOMAIN_CONTACT_ENCRYPTION_KEY=
# Optional HTTPS availability lookup adapter (manual confirmation is the default).
DOMAIN_AVAILABILITY_URL=
DOMAIN_AVAILABILITY_API_KEY=
# Server-only GO54 authentication; never NEXT_PUBLIC_. No write API is enabled.
GO54_RESELLER_EMAIL=
GO54_API_KEY=
# Enable only after reviewing registry access/usage rules for each allowed TLD.
DOMAIN_RDAP_ENABLED=false
DOMAIN_RDAP_ALLOWED_TLDS=
# Exact supported hosting DNS targets, confirmed by the operator; not guessed defaults.
DOMAIN_WEBSITE_CNAME=
DOMAIN_WEBSITE_IPV4=
# Each independent Custom website uses JKTL_CUSTOM_PROJECT_ID + JKTL_CUSTOM_API_KEY
# in its OWN server environment. Business stores only the integration key hash.
# Existing AI/storage/push/auth settings remain documented in README.md.
# Optional: same private value (32+ characters) in Main and Business deployments
# to review/import earlier Main partner enquiries into the approval queue.
JKTL_PARTNER_BRIDGE_SECRET=
